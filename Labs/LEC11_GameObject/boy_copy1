from pico2d import *  # pico2d의 이미지·창·이벤트 관련 함수와 상수를 가져옵니다.
import random        # 무작위 숫자를 만드는 기능을 가져옵니다.


# ==================================================
# 1. 잔디 클래스: 잔디 객체를 만들기 위한 설계도
# 클래스 정의만으로는 객체가 생성되거나 그림이 나오지 않습니다.
# ==================================================
class Grass:
    def __init__(self):
        # __init__은 Grass()로 객체를 만들 때 자동 실행됩니다.
        # self는 지금 만들어진 잔디 객체 자신을 뜻합니다.
        # self.image는 그 객체가 가지고 있는 이미지입니다.
        self.image = load_image('grass.png')  # 잔디 이미지 불러오기

    def draw(self):
        # 불러온 이미지를 화면에 그립니다.
        # 이미지의 중심이 화면 좌표 (400, 30)에 놓입니다.
        self.image.draw(400, 30)

    def update(self):
        # update는 객체의 상태를 바꾸는 메서드입니다.
        # 잔디는 움직이지 않으므로 아무것도 하지 않습니다.
        pass

    # 클래스 끝의 추가 pass는 필요하지 않아서 생략했습니다.


# ==================================================
# 2. 소년 클래스: 소년 객체의 초기 상태와 동작 정의
# ==================================================
class Boy:
    def __init__(self):
        # x는 100~700 사이에서 무작위 정수로 정합니다.
        # randint는 양 끝인 100과 700도 포함합니다.
        # y는 항상 90입니다.
        # 이 위치는 객체가 만들어질 때 한 번 정해집니다.
        self.x, self.y = random.randint(100, 700), 90

        # 애니메이션의 첫 번째 그림 번호입니다.
        # 그림 번호는 0부터 시작합니다.
        self.frame = 0

        # 소년의 달리기 그림들이 들어 있는 이미지를 불러옵니다.
        self.image = load_image('run_animation.png')

    def draw(self):
        # 원본 이미지에서 현재 프레임 한 칸을 잘라 그립니다.
        self.image.clip_draw(
            self.frame * 100,  # 원본에서 자를 영역의 왼쪽 x좌표
            0,                 # 원본에서 자를 영역의 아래쪽 y좌표
            100,               # 자를 너비
            100,               # 자를 높이
            self.x,            # 화면에 그릴 중심 x좌표
            self.y             # 화면에 그릴 중심 y좌표
        )

        # 예: frame이 2라면 원본의 (200, 0)에서
        # 가로 100, 세로 100만큼 잘라 화면에 그립니다.
        #
        # 원본에서 자르는 위치와 화면에 그리는 위치는 다릅니다.
        # frame * 100은 원본 위치, self.x와 self.y는 화면 위치입니다.

    def update(self):
        # 그림 번호를 하나 증가시킵니다.
        # %는 나눗셈의 나머지 연산입니다.
        # 0 → 1 → ... → 7 → 0 순서로 반복됩니다.
        self.frame = (self.frame + 1) % 8

        # 현재 x좌표에 5를 더합니다.
        # pico2d에서 x가 커지면 오른쪽으로 이동합니다.
        # y는 변경하지 않으므로 높이는 그대로입니다.
        self.x += 5


# ==================================================
# 3. 좀비 클래스
# 소년과 구조는 같지만 이미지의 크기와 프레임 수가 다릅니다.
# 클래스 이름 zombie는 사용자가 정한 이름입니다.
# 일반적으로 클래스는 Zombie처럼 첫 글자를 대문자로 쓰지만,
# 현재 코드의 이름을 그대로 유지했습니다.
# ==================================================
class zombie:
    def __init__(self):
        # 좀비의 시작 위치를 (0, 90)으로 설정합니다.
        # 화면 중심 x좌표가 0이므로 처음에는 일부가 왼쪽 밖에 있습니다.
        self.x, self.y = 0, 90

        # 좀비도 0번 그림부터 시작합니다.
        self.frame = 0

        # 좀비의 달리기 이미지 불러오기
        self.image = load_image('zombie_run_animation.png')

    def draw(self):
        # 현재 좀비 이미지는 전체 4300 × 519입니다.
        # 그림 10개가 가로로 있어 한 칸은 430 × 519입니다.
        self.image.clip_draw(
            self.frame * 430,  # 원본에서 자를 x좌표: 칸 번호 × 칸 너비
            0,                 # 원본의 맨 아래에서 시작
            430,               # 원본에서 자를 너비
            519,               # 원본에서 자를 높이
            self.x,            # 화면에 그릴 중심 x좌표
            self.y,            # 화면에 그릴 중심 y좌표
            40,                # 화면에서는 너비 40으로 표시
            50                 # 화면에서는 높이 50으로 표시
        )

        # 앞쪽 430, 519: 원본에서 그림 한 장을 자르는 크기
        # 마지막 40, 50: 화면에 표시하는 크기
        #
        # 좀비를 작게 만들려면 마지막 두 숫자를 줄입니다.
        # 원본 자르는 크기를 줄이면 몸의 일부만 잘려 나옵니다.
        # 원본 비율에 더 가깝게 표시하려면 42, 50 정도를 사용할 수 있습니다.

    def update(self):
        # 좀비는 그림이 10개라서 % 10을 사용합니다.
        # 0 → 1 → ... → 9 → 0 순서로 반복됩니다.
        self.frame = (self.frame + 1) % 10

        # 좀비도 매번 오른쪽으로 5만큼 이동합니다.
        self.x += 5

        # 현재 코드에는 화면 경계 처리가 없습니다.
        # 소년과 좀비 모두 시간이 지나면 오른쪽 화면 밖으로 나갑니다.


# ==================================================
# 4. 입력 처리 함수
# 클래스 안의 메서드와 달리 게임 전체에서 사용하는 함수입니다.
# ==================================================
def handle_events():
    # 전역변수 running에 값을 다시 대입하기 위해 선언합니다.
    # global 자체가 값을 만드는 것은 아닙니다.
    # running의 최초 값은 reset_world()에서 설정합니다.
    global running

    # 키보드·마우스·창에서 발생한 이벤트들을 리스트로 가져옵니다.
    events = get_events()

    # 이벤트 리스트에서 이벤트를 하나씩 꺼냅니다.
    # 이벤트가 없다면 반복문 내부는 실행하지 않습니다.
    for event in events:
        # 창의 X 버튼을 누른 이벤트인지 확인합니다.
        if event.type == SDL_QUIT:
            # 게임을 계속 실행하지 않도록 상태를 바꿉니다.
            running = False

        # 키를 누른 이벤트이고, 그 키가 ESC인지 확인합니다.
        # and는 두 조건이 모두 참이어야 한다는 뜻입니다.
        elif event.type == SDL_KEYDOWN and event.key == SDLK_ESCAPE:
            running = False


# ==================================================
# 5. 게임의 시작 상태와 객체들을 준비
# ==================================================
def reset_world():
    # 함수 안에서 전역 running을 설정합니다.
    global running

    # global 선언 뒤 대입하므로 전역변수 running이 만들어집니다.
    # True는 게임을 계속 실행하겠다는 뜻입니다.
    running = True

    # 잔디 객체를 다른 함수에서도 사용할 수 있도록 전역 이름으로 둡니다.
    global grass

    # Grass()로 잔디 객체 한 개를 생성합니다.
    # 이때 Grass.__init__이 자동 실행되어 이미지를 불러옵니다.
    grass = Grass()

    # 게임 객체들을 담는 world를 전역변수로 사용합니다.
    global world

    # 처음에는 아무 객체도 없는 빈 리스트입니다.
    world = []

    # 잔디 객체 한 개를 리스트에 추가합니다.
    # 현재 world: [잔디]
    world.append(grass)

    # 아래 두 줄은 주석이므로 실행되지 않습니다.
    # 지금은 소년 한 명을 따로 만들지 않고 team으로 만듭니다.
    # global boy
    # boy = Boy()

    # 여러 소년을 담을 team 리스트를 전역 이름으로 둡니다.
    global team

    # range(0, 11)은 0~10으로 총 11번 반복합니다.
    # 반복할 때마다 Boy()를 호출하여 새로운 소년을 만듭니다.
    # 각 소년은 자기 x, y, frame 값을 따로 가지고 있습니다.
    # i는 반복 번호이지만 이 표현에서는 사용하지 않습니다.
    team = [Boy() for i in range(0, 11)]

    # team 안의 소년들을 world에 각각 추가합니다.
    # 현재 world: [잔디, 소년1, 소년2, ..., 소년11]
    world += team

    # 좀비 객체를 가리킬 zom을 전역 이름으로 둡니다.
    global zom

    # 좀비 객체 한 개 생성
    # 이때 zombie.__init__이 자동으로 실행됩니다.
    zom = zombie()

    # 객체 하나이므로 append를 사용합니다.
    # world += zom은 zom이 순회 가능한 리스트가 아니므로 오류입니다.
    world.append(zom)

    # 최종 world:
    # 잔디 1개 + 소년 11개 + 좀비 1개 = 총 13개 객체
    #
    # world.append(team)은 소년들을 각각 추가하는 것이 아니라
    # team 리스트 자체를 하나의 항목으로 넣으므로 여기서는 맞지 않습니다.


# ==================================================
# 6. 모든 게임 객체의 상태 갱신
# ==================================================
def update_world():
    # world의 객체들을 순서대로 하나씩 꺼냅니다.
    # o는 이번 반복에서 꺼낸 객체를 가리키는 변수입니다.
    # 이름은 o 대신 obj나 member로 바꿔도 됩니다.
    for o in world:
        # 잔디라면 Grass.update(): pass라 변화 없음
        # 소년이라면 Boy.update(): 프레임 변경과 이동
        # 좀비라면 zombie.update(): 프레임 변경과 이동
        o.update()

    # world에 새 값을 대입하지 않고 읽어서 사용하므로
    # 여기서는 global world 선언이 필요하지 않습니다.
    # 함수 끝의 pass도 이미 실행문이 있으므로 필요하지 않습니다.


# ==================================================
# 7. 모든 게임 객체를 화면에 그리기
# ==================================================
def render_world():
    # 이전 반복에서 그린 화면을 지웁니다.
    clear_canvas()

    # 리스트 순서대로 그리므로 잔디 → 소년들 → 좀비 순서입니다.
    # 같은 위치에 겹치면 나중에 그린 객체가 앞에 보입니다.
    for o in world:
        # 상태를 바꾸는 update가 아니라
        # 그림을 그리는 draw를 호출해야 합니다.
        o.draw()

    # 지금 그린 내용을 실제 화면에 표시합니다.
    update_canvas()


# ==================================================
# 8. 실제 프로그램 실행
# 위의 클래스·함수는 정의만 했고, 여기서 호출하며 실행합니다.
# ==================================================

# 기본 크기인 800 × 600 게임 창을 엽니다.
# 이미지를 불러오는 reset_world()보다 먼저 실행합니다.
open_canvas()

# 실행 상태를 설정하고 잔디·소년·좀비를 생성합니다.
reset_world()

# running이 True인 동안 게임을 반복합니다.
while running:
    # 1. X 또는 ESC 입력이 있는지 확인합니다.
    handle_events()

    # 2. 각 객체의 위치와 프레임을 변경합니다.
    update_world()

    # 3. 변경된 상태에 맞춰 화면을 그립니다.
    render_world()

    # 4. 0.05초 동안 기다립니다.
    # 실제 반복 시간에는 위 함수들의 처리 시간도 포함됩니다.
    delay(0.05)

    # handle_events()에서 running이 False