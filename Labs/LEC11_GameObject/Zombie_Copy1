from pico2d import *  # 창 열기, 이미지 출력, 이벤트 처리 도구 가져오기
import random        # 무작위 숫자를 만드는 도구 가져오기


# ==================================================
# 1. 잔디 클래스: 잔디 객체의 데이터와 동작을 정의
# ==================================================
class Grass:
    def __init__(self):
        # Grass()로 객체를 만들 때 자동으로 실행됩니다.
        # self는 지금 만들어지는 잔디 객체 자신입니다.
        self.image = load_image('grass.png')  # 이 객체의 이미지 저장

    def draw(self):
        # 이미지 중심을 화면의 (400, 30)에 맞춰 그립니다.
        self.image.draw(400, 30)

    def update(self):
        # 잔디는 움직이지 않으므로 변경할 상태가 없습니다.
        pass  # 아무것도 하지 않고 넘어갑니다.


# ==================================================
# 2. 소년 클래스: 각 소년은 자기 위치와 프레임을 가집니다.
# ==================================================
class Boy:
    def __init__(self):
        # Boy()를 호출할 때마다 새로운 소년 객체가 만들어집니다.
        self.image = load_image('run_animation.png')

        self.frame = 0  # 첫 번째 동작 그림부터 시작합니다.

        # 시작 x좌표는 100~700 사이의 정수입니다. 양 끝도 포함합니다.
        # 시작 y좌표는 항상 90입니다.
        # 여러 소년의 x좌표가 우연히 같아 겹칠 수도 있습니다.
        self.x, self.y = random.randint(100, 700), 90

    def draw(self):
        # 원본 이미지의 한 칸은 100×100입니다.
        self.image.clip_draw(
            self.frame * 100,  # 자를 시작 x좌표: 그림 번호 × 한 칸 너비
            0,                 # 자를 시작 y좌표: 원본 맨 아래 행
            100,               # 자를 너비
            100,               # 자를 높이
            self.x,            # 화면에 그릴 중심 x좌표
            self.y             # 화면에 그릴 중심 y좌표
        )
        # 출력 크기를 따로 지정하지 않아 잘라낸 크기로 그립니다.

    def update(self):
        # %는 나머지 연산입니다.
        # 그림 번호를 0 → 1 → ... → 7 → 0으로 반복합니다.
        self.frame = (self.frame + 1) % 8

        # x가 증가하므로 오른쪽으로 이동합니다.
        # update()를 한 번 호출할 때마다 5픽셀 이동합니다.
        self.x += 5


# ==================================================
# 3. 좀비 클래스: 소년과 구조는 같고 이미지 규격이 다릅니다.
# ==================================================
class Zombie:
    def __init__(self):
        # 실제 이미지 파일 이름과 일치해야 합니다.
        self.image = load_image('Zombie_run_animation.png')

        self.frame = 0         # 첫 번째 그림부터 시작
        self.x, self.y = 0, 90  # 시작 위치: 화면 왼쪽, 높이 90

    def draw(self):
        # self.image.w는 이미지 전체 너비입니다.
        # 같은 크기의 그림 10개가 가로 한 줄에 있으므로
        # 전체 너비를 10으로 나누면 한 프레임의 너비가 됩니다.
        frame_width = self.image.w // 10  # //는 몫을 구하는 나눗셈

        # 그림이 한 줄이므로 전체 높이가 한 프레임의 높이입니다.
        frame_height = self.image.h

        # 아래 변수들은 이 draw() 안에서 사용하는 지역변수입니다.
        # 현재 파일이 4300×519라면 한 칸은 430×519입니다.
        self.image.clip_draw(
            self.frame * frame_width,  # 원본에서 자를 시작 x좌표
            0,                         # 원본에서 자를 시작 y좌표
            frame_width,               # 원본에서 자를 너비
            frame_height,              # 원본에서 자를 높이
            self.x,                    # 화면에 그릴 중심 x좌표
            self.y,                    # 화면에 그릴 중심 y좌표
            120,                       # 화면에 표시할 너비
            70                         # 화면에 표시할 높이
        )
        # 원본 자르기 크기와 화면 표시 크기는 서로 다릅니다.
        # 작게 만들려면 마지막 두 숫자만 줄이면 됩니다.
        # 현재 120×70은 가로로 넓어진 모습입니다.
        # 원래 비율을 유지하면서 높이 70으로 그리려면 약 58×70입니다.

    def update(self):
        # 좀비의 그림은 10개이므로 번호를 0~9까지 반복합니다.
        self.frame = (self.frame + 1) % 10

        self.x += 5  # 오른쪽으로 5픽셀 이동합니다.


# ==================================================
# 4. 입력 처리: 창 닫기와 ESC 키 확인
# ==================================================
def handle_events():
    # reset_world()에서 만든 전역 running을 변경하기 위해 선언합니다.
    global running

    events = get_events()  # 발생한 이벤트들을 리스트로 가져옵니다.

    for event in events:  # 이벤트를 하나씩 확인합니다.
        if event.type == SDL_QUIT:
            # 창의 X 버튼을 눌렀다면 종료 상태로 바꿉니다.
            running = False

        elif event.type == SDL_KEYDOWN and event.key == SDLK_ESCAPE:
            # 키를 누른 이벤트이고, 그 키가 ESC라면 종료합니다.
            # and는 두 조건이 모두 참이어야 한다는 뜻입니다.
            running = False


# ==================================================
# 5. 게임 준비: 객체를 생성해서 world에 넣기
# ==================================================
def reset_world():
    global running
    running = True  # 게임을 계속 실행하는 상태로 설정합니다.

    global grass
    grass = Grass()  # 잔디 객체 생성 → __init__ 자동 실행

    global world
    world = []  # 모든 게임 객체를 담을 빈 리스트를 만듭니다.

    world.append(grass)  # 객체 하나를 리스트에 추가합니다.

    global team

    # range(0, 5)는 0, 1, 2, 3, 4로 총 5번 반복합니다.
    # 매번 Boy()를 호출하므로 소년 객체 5개가 만들어집니다.
    # i는 반복 번호지만 여기서는 따로 사용하지 않습니다.
    team = [Boy() for i in range(0, 5)]

    # team에 들어 있는 소년들을 world에 각각 추가합니다.
    # 이미 만든 소년을 참조하는 것이며, 새로 만드는 것은 아닙니다.
    world += team

    global Zom
    Zom = Zombie()  # 좀비 객체 한 개를 만듭니다.

    world.append(Zom)  # 객체 한 개이므로 append로 추가합니다.

    # world 구성:
    # 잔디 1개 + 소년 5개 + 좀비 1개 = 총 7개 객체
    #
    # world.append(Zom): 객체 하나 추가
    # world += team: 리스트 안의 객체들을 각각 추가
    # world += Zom: 객체 하나는 순회할 수 없으므로 오류


# ==================================================
# 6. 모든 객체의 상태 갱신
# ==================================================
def update_world():
    for o in world:
        # o는 world에서 차례로 꺼낸 객체 하나를 가리킵니다.
        # 잔디면 Grass.update(), 소년이면 Boy.update(),
        # 좀비면 Zombie.update()가 실행됩니다.
        o.update()

    # world에 새 값을 대입하지 않고 읽기만 하므로
    # 이 함수에서는 global world가 필요하지 않습니다.


# ==================================================
# 7. 모든 객체를 화면에 그리기
# ==================================================
def render_world():
    clear_canvas()  # 1. 이전 그림을 지웁니다.

    for o in world:
        o.draw()    # 2. 각 객체의 현재 모습과 위치를 그립니다.
        # world에 넣은 순서대로 잔디 → 소년들 → 좀비를 그립니다.

    update_canvas() # 3. 그린 내용을 실제 화면에 표시합니다.


# ==================================================
# 8. 실제 게임 실행
# 위에서는 설계도와 함수를 정의했고, 여기서 호출합니다.
# ==================================================
open_canvas()  # 기본 크기 800×600의 창을 엽니다.

reset_world()  # 실행 상태와 게임 객체들을 준비합니다.

while running:      # running이 True인 동안 반복합니다.
    handle_events() # 입력 확인: X나 ESC라면 running을 False로 변경
    update_world()  # 객체의 위치와 그림 번호 변경
    render_world()  # 변경된 상태를 화면에 그리기
    delay(0.05)     # 0.05초 기다립니다.

close_canvas()      # 반복문을 빠져나오면 창을 닫습니다.

# 현재 코드에는 화면 경계 처리가 없습니다.
# 소년과 좀비는 계속 오른쪽으로 이동하다 화면 밖으로 나갑니다.
#
# ESC를 누르면 현재 반복의 나머지 작업까지 실행하고,
